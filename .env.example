NODE_ENV=development
PORT=3000
SEED_DEMO_USERS=false
DEMO_SEED_PASSWORD=
MAX_UPLOAD_BYTES=10485760
TRUSTED_ORIGINS=https://your-trustvault-domain.example
# Required in production. Supply a random secret of at least 32 bytes through your host secret manager.
# Keep this key separate from the database and do not commit a real value.
AUDIT_HMAC_KEY=

# Optional external append-only audit receiver. Required for independently anchored production audit.
# Receiver must verify X-TrustVault-Signature and deduplicate by Idempotency-Key.
AUDIT_SINK_URL=
AUDIT_SINK_TOKEN=

# 32-byte AES-256-GCM key as 64 hexadecimal characters; protect like a password.
MFA_ENCRYPTION_KEY=
